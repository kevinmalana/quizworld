# QuizWorld Phoenix Backend Environment Variables
# Copy to .env and fill in values

# Supabase (required)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SUPABASE_SERVICE_ROLE_KEY  # Service role key from Supabase Dashboard → Settings → API

# Redis (optional but recommended for production)
# Without Redis, game state only lives in memory and is lost on restart
REDIS_URL=redis://default:password@host:port

# Phoenix
PHX_HOST=quizworld-xs0g.onrender.com
SECRET_KEY_BASE=  # Generate with: mix phx.gen.secret
ALLOWED_ORIGINS=https://www.quizworld.xyz,http://localhost:3000
PORT=4100
