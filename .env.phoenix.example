# QuizWorld Phoenix backend environment variables
# Copy to a local untracked env file or configure these in Render.

# Supabase: required for authentication and durable result synchronization.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Redis: required in production for live-game restart recovery.
REDIS_URL=redis://default:password@host:port

# Phoenix
PHX_HOST=quizworld-xs0g.onrender.com
SECRET_KEY_BASE=replace-with-output-from-mix-phx-gen-secret
SESSION_SIGNING_SALT=replace-with-a-random-signing-salt
ALLOWED_ORIGINS=https://www.quizworld.xyz,https://quizworld.xyz,http://localhost:3000
PORT=4100
