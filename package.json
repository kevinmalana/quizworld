{
  "name": "quizworld",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "typecheck": "tsc --noEmit --pretty false",
    "quality": "node scripts/quality-check.js",
    "check": "npm run quality && npm run typecheck && npm run build && npm run check:phoenix",
    "start": "next start",
    "test:e2e": "npx playwright test",
    "test:e2e:ui": "npx playwright test --ui",
    "test:e2e:headed": "npx playwright test --headed",
    "check:phoenix": "cd services/quizworld_realtime && MIX_ENV=test mix compile --warnings-as-errors && MIX_ENV=test mix test"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@supabase/ssr": "^0.9.0",
    "@supabase/supabase-js": "^2.100.1",
    "dotenv": "^17.3.1",
    "mammoth": "^1.12.0",
    "next": "16.1.6",
    "pdfjs-dist": "^5.7.284",
    "react": "19.2.3",
    "react-dom": "19.2.3"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "tailwindcss": "^4",
    "typescript": "5.9.3"
  }
}
