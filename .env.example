# QuizWorld Environment Variables
# Copy to .env.local for local development

# ── Supabase (required) ────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR_SUPABASE_ANON_KEY

# ── Game Engine ─────────────────────────────────────────────────
# Options: "phoenix" (default) or "supabase" (legacy)
NEXT_PUBLIC_GAME_ENGINE=phoenix
NEXT_PUBLIC_GAME_SERVICE_URL=http://localhost:4100

# ── AI Features (Groq) ─────────────────────────────────────────
QUIZWORLD_AI_API_KEY=YOUR_GROQ_API_KEY
QUIZWORLD_AI_MODEL=llama-3.1-8b-instant
QUIZWORLD_AI_API_URL=https://api.groq.com/openai/v1/chat/completions

# ── Optional: Error Tracking ────────────────────────────────────
# NEXT_PUBLIC_SENTRY_DSN=https://...@sentry.io/...
# SENTRY_AUTH_TOKEN=...

# ── Optional: Analytics ─────────────────────────────────────────
# NEXT_PUBLIC_GA_ID=G-...
