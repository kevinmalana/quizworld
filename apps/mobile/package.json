{
  "name": "@quizworld/mobile",
  "version": "0.1.0",
  "main": "index.ts",
  "dependencies": {
    "@noble/hashes": "^2.4.0",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "^7.19.1",
    "@react-navigation/native": "^7.4.1",
    "@react-navigation/native-stack": "^7.19.1",
    "expo": "~57.0.23",
    "expo-crypto": "~57.0.3",
    "expo-status-bar": "~57.0.1",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "^0.21.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.3",
    "@types/react": "~19.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts src/study/*.test.ts",
    "test:e2e": "playwright test",
    "export:web": "expo export --platform web --max-workers 1",
    "export:native": "expo export --platform android --platform ios --max-workers 1",
    "preview": "node scripts/preview.cjs",
    "check": "npm run typecheck && npm test"
  },
  "private": true
}
