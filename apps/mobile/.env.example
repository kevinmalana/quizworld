EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_ANON_KEY=
# Public anonymous/publishable key only. Never use a service-role or secret key.
# Empty Supabase configuration keeps the bundled sample fully functional.
# Live joining defaults to the verified website Phoenix service, with no key.
